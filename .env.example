# ============================================================
# JobRadar - Environment Configuration
# Copy this file to `.env` and fill in the required values.
# Only ANTHROPIC_API_KEY is strictly required if USE_MOCK_DATA=true.
# ============================================================

# --- Auth (required) ---
# Signs/verifies JWTs. No safe default - generate your own:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Every endpoint that touches CV/application/match data requires a valid
# token (POST /auth/jwt/login) minted with this secret. Required even in
# DEMO_MODE - the placeholder demo CV is still a per-user resource now.
AUTH_SECRET=
AUTH_TOKEN_LIFETIME_SECONDS=3600

# --- Redis (required) ---
# Backs the arq job queue (CV processing, per-user matching), the
# per-user LLM quota counter, and the rate limiter - one piece of infra
# for all three.
REDIS_URL=redis://localhost:6379/0

# --- Per-user LLM quota (optional) ---
# Request-count cap per user per day, not a dollar cap - see
# ANTHROPIC_PRICING_JSON below for why cost tracking stays count-based.
LLM_DAILY_QUOTA_PER_USER=50

# --- Rate limiting (optional) ---
# IP-based limiter (api/rate_limit.py) on POST /cv and POST /run. Leave
# true for any real deployment; tests disable this themselves regardless
# of this value (see config.py's `rate_limiting_enabled` docstring).
RATE_LIMITING_ENABLED=true

# --- GDPR (optional) ---
# Policy value surfaced in docs/PRIVACY.md and GET /me/export - not an
# automatic purge job (see docs/PRIVACY.md for why).
DATA_RETENTION_DAYS=365

# --- Public demo (optional) ---
# When true, overrides USE_MOCK_DATA/CV_PATH to force mock jobs + the
# placeholder cv/cv.example.txt, and POST /cv returns 403. Set this true for
# any publicly reachable deployment - see docs/DEPLOYMENT.md.
DEMO_MODE=false

# --- LLM (required) ---
# Anthropic API key - get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Legacy single-tier model - no longer read; kept so old .env files work.
CLAUDE_MODEL=claude-sonnet-4-20250514
# Two-tier model config: fast tier for extraction/bulk work, smart tier
# for explanations.
LLM_MODEL_FAST=claude-haiku-4-5-20251001
LLM_MODEL_SMART=claude-sonnet-5

# --- Job sources (optional) ---
# Adzuna API credentials - free tier at https://developer.adzuna.com/
# Leave blank to skip Adzuna and fall back to other sources / mock data.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Set to `true` for a zero-external-dependency demo run.
# When true, live APIs are skipped and `data/mock_jobs.json` is used.
USE_MOCK_DATA=true

# Default search terms used by the scheduled daily run.
DEFAULT_QUERY=AI Engineer
DEFAULT_LOCATION=Munich

# --- CV / RAG (optional - sensible defaults) ---
# Path to your plain-text CV: copy cv/cv.example.txt to cv/cv.txt and put
# your own CV in it (cv/cv.txt is gitignored).
CV_PATH=cv/cv.txt
# Legacy FAISS cache path - unused once pgvector retrieval is active,
# kept only so a rollback to the old RAG agent doesn't need a new env var.
FAISS_INDEX_PATH=cv/cv.faiss
# Default per docs/ARCHITECTURE.md: multilingual-e5-base (many postings are German).
# Set to sentence-transformers/all-MiniLM-L6-v2 (dim 384, set EMBEDDING_DIM=384
# too) to reproduce the old v1 scoring for the evaluation comparison.
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768
CV_CHUNK_TOKENS=200
CV_CHUNK_OVERLAP=40
# Max upload size for POST /cv.
CV_MAX_UPLOAD_MB=5

# --- Scoring (optional, must sum to 1.0) ---
SCORE_WEIGHT_TECHNICAL_SKILLS=0.35
SCORE_WEIGHT_EXPERIENCE=0.25
SCORE_WEIGHT_RESPONSIBILITIES=0.15
SCORE_WEIGHT_SENIORITY=0.10
SCORE_WEIGHT_LOCATION_LANGUAGE=0.10
SCORE_WEIGHT_EDUCATION=0.05
# Final score is capped at this if any mandatory requirement is missing.
SCORE_BLOCKER_CAP=0.3
# Cosine similarity above this counts as a semantic requirement match.
SEMANTIC_MATCH_THRESHOLD=0.55
# Only the top N scored jobs get an LLM explanation (cost control).
EXPLANATION_TOP_N=5

# --- Job dedup (optional) ---
# Cosine similarity threshold (after canonical-URL and normalized-triple
# matches fail) above which two postings are treated as the same job.
JOB_DEDUP_EMBEDDING_THRESHOLD=0.93

# --- Email delivery (optional) ---
# If EMAIL_RECIPIENT is blank, the digest is written to output/ only.
# For Gmail use an App Password: https://myaccount.google.com/apppasswords
EMAIL_SENDER=
EMAIL_RECIPIENT=
EMAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- Database (required for local, non-Docker use) ---
# Postgres + pgvector is the default store. Run
# `docker compose up -d postgres` for a local instance matching these
# defaults, or point DATABASE_URL at your own Postgres with the `vector`
# extension installed. SQLite (sqlite:///jobradar.db) still works for quick
# experiments, but job_embeddings/cv_chunks (pgvector columns) require Postgres.
DATABASE_URL=postgresql+psycopg://jobradar:jobradar@localhost:5432/jobradar
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=jobradar
POSTGRES_DB=jobradar

# --- Scheduler (optional) ---
# 24-hour clock. Default 06:00 server-local time.
SCHEDULE_HOUR=6
SCHEDULE_MINUTE=0
# true runs the scheduler in this process (fine for
# `python main.py` standalone). docker-compose's `api` service sets this
# false - the separate `scheduler` service (scheduler_worker.py) owns it.
RUN_SCHEDULER=true
SCHEDULER_HEARTBEAT_FILE=data/scheduler_heartbeat

# --- Pipeline tuning (optional) ---
MAX_JOBS_PER_SOURCE=25
TOP_N_FOR_ANALYST=20
ANALYST_CONCURRENCY=5

# --- MCP memory server (optional) ---
# Command used to spawn the knowledge-graph MCP server. Requires Node.js / npx.
MCP_MEMORY_CMD=npx -y @modelcontextprotocol/server-memory
# Where the MCP server persists its JSON graph.
MCP_MEMORY_FILE=data/memory.json

# --- Observability (optional) ---
# Langfuse cloud tracing for every LLM call. Leave both blank to disable -
# the app runs identically either way (observability/tracing.py no-ops).
# Get keys at https://cloud.langfuse.com/ (a free project is enough).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Optional JSON: {"<model_id>": {"input_per_mtok": <usd>, "output_per_mtok": <usd>}}.
# Without this, cost-per-job is reported as unavailable rather than guessed -
# we don't hardcode Anthropic pricing we can't verify is current.
ANTHROPIC_PRICING_JSON=

# --- Logging / misc ---
LOG_LEVEL=INFO
OUTPUT_DIR=output
